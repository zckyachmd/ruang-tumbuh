# Use a long random URL-safe value (letters, numbers, underscore, hyphen).
POSTGRES_PASSWORD=
# Generate with: openssl rand -base64 32. Keep a separate protected copy for recovery.
APP_DATA_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
APP_PORT=8000
# Required only with compose.hosted.yaml; set to a DNS name pointing at this host.
APP_DOMAIN=
# Local synthetic data only. Never expose a development server to the network.
APP_ENV=production
DEV_AUTH_ENABLED=0
TELEGRAM_WEBHOOK_SECRET=
# disabled, webhook, or polling. Polling requires: docker compose --profile polling up -d
TELEGRAM_TRANSPORT=disabled
# Long-poll wait in seconds; app accepts 1-50. Network timeout adds 10 seconds.
TELEGRAM_POLL_TIMEOUT=30
# disabled, fake (development only), or telegram
TELEGRAM_DELIVERY=disabled
# 1-30 days to retain chat payloads and terminal response text; default 7
CHAT_CONTENT_RETENTION_DAYS=7
# fake or openai-compatible service (not api.openai.com). Compatible endpoints must use HTTPS except localhost.
AI_PROVIDER=fake
# Provider's OpenAI-compatible endpoint base URL, including version path; direct OpenAI API URLs and redirects are rejected.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
